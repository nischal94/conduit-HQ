#!/bin/sh
# Pre-push gate for the commit-routing rule (CLAUDE.md "Commit routing").
#
# Direct pushes to main may only touch inert prose (HANDOFF.md,
# LEARNINGS.md). Everything else goes branch -> PR -> CI green -> merge:
# only the PR route puts the human decision AFTER the clean-room CI
# evidence exists, and the CI supply-chain review step fires only on
# pull_request events.
#
# This is a tripwire, not a wall: `git push --no-verify` bypasses it.
# Treat a bypass as an incident worth a LEARNINGS note.
# Enabled via: git config core.hooksPath githooks

set -e

ZERO=0000000000000000000000000000000000000000

# stdin, one line per ref being pushed:
#   <local ref> <local sha> <remote ref> <remote sha>
while read -r _ local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  if ! changed=$(git diff --name-only "$range" 2>/dev/null); then
    echo "pre-push: cannot resolve $range locally. Run: git fetch origin main, then retry." >&2
    exit 1
  fi

  blocked=$(printf '%s\n' "$changed" | grep -vxF -e HANDOFF.md -e LEARNINGS.md -e CLAUDE.md || true)

  if [ -n "$blocked" ]; then
    {
      echo "pre-push: BLOCKED — this push to main touches more than inert prose:"
      printf '%s\n' "$blocked" | sed 's/^/  /'
      echo ""
      echo "Only HANDOFF.md / LEARNINGS.md go direct to main (CLAUDE.md: commit routing)."
      echo "Route it through a PR instead:"
      echo "  git checkout -b <feat|fix|docs|refactor>/<name>   # commits come along"
      echo "  git push -u origin HEAD && gh pr create --fill"
      echo "  (then move local main back: git checkout main && git reset --keep origin/main)"
    } >&2
    exit 1
  fi
done

exit 0
