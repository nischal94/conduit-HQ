{
  "name": "@conduithq/sdk",
  "version": "0.1.0",
  "description": "Conduit core SDK — the open-source integration layer for AI agents.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "ajv": "^8.17.1",
    "quickjs-emscripten": "^0.31.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
