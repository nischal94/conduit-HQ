#!/bin/sh
# Guarded docs-only push to main (CLAUDE.md "Commit routing").
#
# The one sanctioned agent path for pushing main directly: verifies that
# every outgoing commit touches nothing but the inert-prose allowlist
# (HANDOFF.md, LEARNINGS.md), then pushes. Anything else exits loudly —
# use the PR route. The pre-push hook re-checks the same rule, so a bug
# here still gets caught there (two independent gates).
#
# The agent-side permission allow for this script lives in
# .claude/settings.local.json; the global deny on `git push origin main`
# stays intact everywhere else.

set -e

cd "$(git rev-parse --show-toplevel)"

branch=$(git branch --show-current)
if [ "$branch" != "main" ]; then
  echo "push-docs: refusing — current branch is '$branch', not main." >&2
  exit 1
fi

git fetch origin main --quiet

blocked=$(git diff --name-only origin/main..HEAD | grep -vxF -e HANDOFF.md -e LEARNINGS.md || true)
if [ -n "$blocked" ]; then
  {
    echo "push-docs: refusing — outgoing commits touch more than inert prose:"
    printf '%s\n' "$blocked" | sed 's/^/  /'
    echo "Route through a PR instead (CLAUDE.md: commit routing)."
  } >&2
  exit 1
fi

if [ -z "$(git rev-list origin/main..HEAD)" ]; then
  echo "push-docs: nothing to push — main is in sync with origin."
  exit 0
fi

git push origin main
