#!/bin/sh
# Guarded docs-only push to main (CLAUDE.md "Commit routing").
#
# The one sanctioned agent path for pushing main directly: verifies that
# every outgoing commit touches only files on .pushallowlist, then
# pushes. Anything else exits loudly — use the PR route. The pre-push
# hook independently re-checks the same rule via the same shared lib
# (scripts/routing-lib.sh), so a bug here still gets caught there.
#
# The agent-side permission allow for this script lives in
# .claude/settings.local.json; the global deny on `git push origin main`
# stays intact everywhere else.

set -e

cd "$(git rev-parse --show-toplevel)"

# shellcheck source=scripts/routing-lib.sh
. scripts/routing-lib.sh
load_allowlist

branch=$(git branch --show-current)
if [ "$branch" != "main" ]; then
  echo "push-docs: refusing — current branch is '$branch', not main." >&2
  exit 1
fi

git fetch origin main --quiet

changed=$(git diff --name-only origin/main..HEAD)
blocked=$(blocked_paths "$changed")

if [ -n "$blocked" ]; then
  {
    echo "push-docs: refusing — outgoing commits touch files not on .pushallowlist:"
    printf '%s\n' "$blocked" | sed 's/^/  /'
    echo "Route through a PR instead (CLAUDE.md: commit routing)."
  } >&2
  exit 1
fi

if [ -z "$(git rev-list origin/main..HEAD)" ]; then
  echo "push-docs: nothing to push — main is in sync with origin."
  exit 0
fi

git push origin main
