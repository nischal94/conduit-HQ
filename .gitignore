.DS_Store
# No trailing slash: worktree sessions symlink node_modules from the main
# checkout, and `node_modules/` matches directories only (LEARNINGS #24).
node_modules
.claude/settings.local.json
# Personal reference material — stays on disk, never in the repo.
assets/
dist/
*.log
.env
.env.*
# Generated outputs that don't exist yet — ignored before first appearance.
coverage/
*.tsbuildinfo
.claude/launch.json
