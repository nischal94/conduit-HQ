.DS_Store
# No trailing slash: worktree sessions symlink node_modules from the main
# checkout, and `node_modules/` matches directories only (LEARNINGS #24).
node_modules
.claude/settings.local.json
# Personal reference material — stays on disk, never in the repo.
assets/
dist/
*.log
.env
.env.*
# Generated outputs that don't exist yet — ignored before first appearance.
coverage/
*.tsbuildinfo
.claude/launch.json
# Daemon test harness bundles the spawnable helper into the package so
# node_modules resolution still works; removed on clean exit, left behind
# only if a run is killed mid-suite.
packages/mcp/.daemon-test-*/
# Private strategy/competitive records — never published (public repo).
docs-private/
